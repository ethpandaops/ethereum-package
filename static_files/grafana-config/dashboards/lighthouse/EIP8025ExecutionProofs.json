      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Execution-proof envelopes received from gossip and the HTTP API.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (instance, source, proof_type) (rate(beacon_execution_proof_received_total{instance=~\"$instance\", proof_type=~\"$proof_type\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} / {{source}} / {{proof_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Execution proofs received",
      "type": "timeseries"
    },
    {
