          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.50, sum by (le, proof_type) (rate(beacon_execution_proof_gossip_processing_seconds_bucket{instance=~\"$instance\", proof_type=~\"$proof_type\"}[$__rate_interval])))",
